<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/np_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:rippleColor="#330E7C6B"
    app:strokeColor="@color/np_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtStationName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/np_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtStationGenre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/np_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/imgPlay"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@null"
            android:padding="4dp"
            android:src="@drawable/ic_play"
            app:tint="@color/np_accent" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
